cmake_minimum_required(VERSION 3.20)
project(YashiMart LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
find_package(Drogon CONFIG REQUIRED)
find_package(SQLite3 REQUIRED)
add_executable(yashimart src/main.cc)
target_link_libraries(yashimart PRIVATE Drogon::Drogon SQLite::SQLite3)
target_compile_definitions(yashimart PRIVATE YASHIMART_WEB_DIR="${CMAKE_CURRENT_SOURCE_DIR}/public")
